use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\onlyoffice\Hook\OnlyofficeHooks;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function onlyoffice_help(string $route_name, RouteMatchInterface $route_match): ?string {
  return \Drupal::service(OnlyofficeHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function onlyoffice_theme(array $existing, string $type, string $theme, string $path): array {
  return \Drupal::service(OnlyofficeHooks::class)->theme($existing, $type, $theme, $path);
}

/**
 * Implements hook_entity_operation().
 */
#[LegacyHook]
function onlyoffice_entity_operation(EntityInterface $entity): array {
  return \Drupal::service(OnlyofficeHooks::class)->entityOperation($entity);
}

/**
 * Implements hook_locale_translation_projects_alter().
 */
#[LegacyHook]
function onlyoffice_locale_translation_projects_alter(array &$projects): void {
  \Drupal::service(OnlyofficeHooks::class)->localeTranslationProjectsAlter($projects);
}

/**
 * Implements hook_library_info_build().
 */
#[LegacyHook]
function onlyoffice_library_info_build(): array {
  return \Drupal::service(OnlyofficeHooks::class)->libraryInfoBuild();
}
