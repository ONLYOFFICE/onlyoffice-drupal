{# onlyoffice/templates/onlyoffice-editor.html.twig #}

<!DOCTYPE html>
<html>

<head>
    <title>{{ filename }} | Drupal</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, minimum-scale=1, user-scalable=no, minimal-ui" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <link rel="icon" href="{{ favicon_path }}" type="image/vnd.microsoft.icon" />

    <style>
        html {
            height: 100%;
            width: 100%;
        }

        body {
            background: #fff;
            color: #333;
            font-family: Arial, Tahoma, sans-serif;
            font-size: 12px;
            font-weight: normal;
            height: 100%;
            margin: 0;
            overflow-y: hidden;
            padding: 0;
            text-decoration: none;
        }

        .onlyoffice-error {
            padding: 20px;
            font-size: 14px;
        }

    </style>

    {% if not error %}
    <script type="text/javascript" src="{{ doc_server_url }}"></script>
    {% endif %}
</head>

<body>
    {% if error %}
    <p class="onlyoffice-error">{{ error }}</p>
    {% else %}
    <div id="iframeEditor"></div>

    <script type="text/javascript">
        var docEditor;

        var connectEditor = function() {
            if (typeof DocsAPI === "undefined") {
              alert("{{ 'ONLYOFFICE cannot be reached. Please contact admin.'|t }}");
              return;
            }

            var docsVersion = DocsAPI.DocEditor.version().split(".");

            if (docsVersion[0] < 6 || docsVersion[0] == 6 && docsVersion[1] == 0) {
              alert("{{ 'Not supported version DocumentServer.'|t }}");
              return;
            }

            var config = {{ config|raw }};
            var saveAsUrl = {{ save_as_url|json_encode|raw }};

            config.events = config.events || {};

            if (saveAsUrl) {
              config.events.onRequestSaveAs = function(event) {
                fetch(saveAsUrl, {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ title: event.data.title, fileType: event.data.fileType, url: event.data.url })
                })
                  .then(function(response) {
                    return response.json();
                  })
                  .then(function(result) {
                    docEditor.showMessage(result.message);
                  })
                  .catch(function() {
                    docEditor.showMessage("{{ 'Failed to save the copy.'|t }}");
                  });
              };
            }

            docEditor = new DocsAPI.DocEditor("iframeEditor", config);
        };

        if (window.addEventListener) {
            window.addEventListener("load", connectEditor);
        } else if (window.attachEvent) {
            window.attachEvent("load", connectEditor);
        }
    </script>
    {% endif %}
</body>

</html>
