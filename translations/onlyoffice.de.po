msgid "Allows editing office files."
msgstr "Erlaubt Bearbeitung von Office-Dateien."

msgid "The ONLYOFFICE connector allows users to edit office documents, spreadsheets, and presentations in the Media module from Drupal using ONLYOFFICE Docs packaged as Document Server. Users are able to collaborate on documents in real-time and preview files on public pages."
msgstr "Der ONLYOFFICE-Konnektor ermöglicht die Bearbeitung von Office-Dokumenten, Tabellenkalkulationen und Präsentationen im Media-Modul von Drupal. Dazu wird ONLYOFFICE Docs verwendet, das als Document Server verpackt ist. Außerdem wird die Echtzeit-Zusammenarbeit an Dokumenten und eine Vorschau der Dateien auf öffentlichen Seiten verfügbar."

msgid "Installation and configuration"
msgstr "Installation und Konfiguration"

msgid "Explore how to install and configure the ONLYOFFICE module for Drupal on the <a href=\":onlyoffice-drupal\">official project page</a>."
msgstr "Erfahren Sie auf der <a href=\":onlyoffice-drupal\">offiziellen Seite des Projekts</a>, wie Sie den ONLYOFFICE-Konnektor für Drupal installieren und konfigurieren können."

msgid "Manage ONLYOFFICE Connector settings."
msgstr "Einstellungen des ONLYOFFICE-Konnektors verwalten."

msgid "ONLYOFFICE Connector settings"
msgstr "Einstellungen vom ONLYOFFICE-Konnektor"

msgid "Welcome to ONLYOFFICE Docs!"
msgstr "Willkommen bei ONLYOFFICE Docs!"

msgid "Add office files to your Drupal website to enable document previews directly on public pages. Collaborate and edit office files with other Drupal users."
msgstr "Fügen Sie Ihrer Drupal-Website Office-Dateien hinzu, um Dokumentvorschauen direkt auf öffentlichen Seiten zu ermöglichen. Bearbeiten Sie Office-Dateien gemeinsam mit anderen Drupal-Benutzern."

msgid "Learn more"
msgstr "Mehr erfahren"

msgid "Suggest a feature"
msgstr "Funktion vorschlagen"

msgid "Connection settings"
msgstr "Verbindungseinstellungen"

msgid "ONLYOFFICE Docs address"
msgstr "Adresse von ONLYOFFICE Docs"

msgid "Here, please specify the address of your ONLYOFFICE Docs server."
msgstr "Geben Sie hier bitte die Adresse Ihres ONLYOFFICE Docs-Servers an."

msgid "ONLYOFFICE Docs secret key"
msgstr "Geheimer Schlüssel von ONLYOFFICE Docs"

msgid "Set a JWT secret key here and the same one in the ONLYOFFICE Docs config file. Leave blank to disable."
msgstr "Legen Sie hier einen geheimen JWT-Schlüssel und denselben in der Konfigurationsdatei von ONLYOFFICE Docs fest. Leer lassen, um zu deaktivieren."

msgid "Edit in ONLYOFFICE"
msgstr "Mit ONLYOFFICE bearbeiten"

msgid "View in ONLYOFFICE"
msgstr "In ONLYOFFICE öffnen"

msgid "ONLYOFFICE cannot be reached. Please contact admin."
msgstr "ONLYOFFICE ist nicht zugänglich. Bitte wende Dich an Deinen Administrator."

msgid "Not supported version DocumentServer."
msgstr "Version vom Document Server nicht unterstützt."

msgid "Sorry, this file format isn't supported (@extension)."
msgstr "Dieses Dateiformat wird leider nicht unterstützt (@extension)."

msgid "ONLYOFFICE Preview"
msgstr "Vorschau in ONLYOFFICE"

msgid "Displaying files using the ONLYOFFICE editor."
msgstr "Anzeigen von Dateien im ONLYOFFICE-Editor."

msgid "Width units"
msgstr "Breiteneinheiten"

msgid "Height units"
msgstr "Höheneinheiten"

msgid "Percents"
msgstr "Prozentsätze"

msgid "Pixels"
msgstr "Bildpunkte"

msgid "Advanced server settings"
msgstr "Erweiterte Servereinstellungen"

msgid "ONLYOFFICE Docs address for internal requests from the server"
msgstr "Die Adresse von ONLYOFFICE Docs für interne Anforderungen vom Server"

msgid "Server address for internal requests from ONLYOFFICE Docs"
msgstr "Serveradresse für interne Anforderungen vom ONLYOFFICE Docs"

msgid "Authorization header (leave blank to use default header)"
msgstr "Authorization-Header (leer lassen, um die standardmäßige Kopfzeile zu verwenden)"

msgid "The address must not contain a query or a fragment."
msgstr "Die Adresse darf keine Abfrage und kein Fragment enthalten."

msgid "The header name may contain only letters, digits and the characters !#$%&'*+-.^_`|~."
msgstr "Der Name der Kopfzeile darf nur Buchstaben, Ziffern und die Zeichen !#$%&'*+-.^_`|~ enthalten."

msgid "ONLYOFFICE Docs connection check succeeded (version @version)."
msgstr "Die Verbindungsprüfung zu ONLYOFFICE Docs war erfolgreich (Version @version)."

msgid "ONLYOFFICE Docs connection check failed: @error"
msgstr "Die Verbindungsprüfung zu ONLYOFFICE Docs ist fehlgeschlagen: @error"

msgid "Error occurred in the document service"
msgstr "Im Dokumentenservice ist ein Fehler aufgetreten"

msgid "Not supported version"
msgstr "Nicht unterstützte Version"

msgid "Mixed Active Content is not allowed. HTTPS address for ONLYOFFICE Docs is required."
msgstr "Mixed Active Content ist nicht möglich. HTTPS-Adresse für ONLYOFFICE Docs ist erforderlich."

msgid "Bad healthcheck status"
msgstr "Ungültiger Healthcheck-Status"
