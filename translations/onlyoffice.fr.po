msgid "Allows editing office files."
msgstr "Permet d'éditer des fichiers bureautiques."

msgid "The ONLYOFFICE connector allows users to edit office documents, spreadsheets, and presentations in the Media module from Drupal using ONLYOFFICE Docs packaged as Document Server. Users are able to collaborate on documents in real-time and preview files on public pages."
msgstr "Le connecteur ONLYOFFICE permet aux utilisateurs d'éditer des documents texte, des feuilles de calcul et des présentations dans le module Media de Drupal en utilisant ONLYOFFICE Docs emballé comme Document Server. Les utilisateurs peuvent collaborer sur les documents en temps réel et prévisualiser les fichiers sur les pages publiques."

msgid "Installation and configuration"
msgstr "Installation et configuration"

msgid "Explore how to install and configure the ONLYOFFICE module for Drupal on the <a href=\":onlyoffice-drupal\">official project page</a>."
msgstr "Découvrez comment installer et configurer le connecteur ONLYOFFICE pour Drupal sur la <a href=\":onlyoffice-drupal\">page officielle du projet</a>."

msgid "Manage ONLYOFFICE Connector settings."
msgstr "Gérez les paramètres du connecteur ONLYOFFICE."

msgid "ONLYOFFICE Connector settings"
msgstr "Paramètres du connecteur ONLYOFFICE"

msgid "Welcome to ONLYOFFICE Docs!"
msgstr "Bienvenue dans ONLYOFFICE Docs !"

msgid "Add office files to your Drupal website to enable document previews directly on public pages. Collaborate and edit office files with other Drupal users."
msgstr "Ajoutez des fichiers Office à votre site Drupal pour afficher des aperçus de documents directement sur les pages publiques. Collaborez et modifiez des fichiers Office avec d'autres utilisateurs de Drupal."

msgid "Learn more"
msgstr "En savoir plus"

msgid "Suggest a feature"
msgstr "Suggérer une fonctionnalité"

msgid "Connection settings"
msgstr "Paramètres de connexion"

msgid "ONLYOFFICE Docs address"
msgstr "Adresse d'ONLYOFFICE Docs"

msgid "Here, please specify the address of your ONLYOFFICE Docs server."
msgstr "Veuillez indiquer ici l'adresse de votre serveur ONLYOFFICE Docs."

msgid "ONLYOFFICE Docs secret key"
msgstr "Clé secrète d'ONLYOFFICE Docs"

msgid "Set a JWT secret key here and the same one in the ONLYOFFICE Docs config file. Leave blank to disable."
msgstr "Définissez ici une clé secrète JWT et la même dans le fichier de configuration d'ONLYOFFICE Docs. Laissez vide pour désactiver."

msgid "Edit in ONLYOFFICE"
msgstr "Modifier dans ONLYOFFICE"

msgid "View in ONLYOFFICE"
msgstr "Afficher dans ONLYOFFICE"

msgid "ONLYOFFICE cannot be reached. Please contact admin."
msgstr "Impossible de joindre ONLYOFFICE. Veuillez contacter l'administrateur."

msgid "Not supported version DocumentServer."
msgstr "Version de Document Server non prise en charge."

msgid "Sorry, this file format isn't supported (@extension)."
msgstr "Malheureusement, ce format de fichier n'est pas pris en charge (@extension)."

msgid "ONLYOFFICE Preview"
msgstr "Aperçu de ONLYOFFICE"

msgid "Displaying files using the ONLYOFFICE editor."
msgstr "Affichage des fichiers avec l'éditeur ONLYOFFICE."

msgid "Width units"
msgstr "Unités de largeur"

msgid "Height units"
msgstr "Unités de hauteur"

msgid "Percents"
msgstr "Pourcentage"

msgid "Pixels"
msgstr "Pixels"

msgid "Advanced server settings"
msgstr "Paramètres avancés du serveur"

msgid "ONLYOFFICE Docs address for internal requests from the server"
msgstr "Adresse du ONLYOFFICE Docs pour les demandes internes du serveur"

msgid "Server address for internal requests from ONLYOFFICE Docs"
msgstr "Adresse du serveur pour les demandes internes du ONLYOFFICE Docs"

msgid "Authorization header (leave blank to use default header)"
msgstr "En-tête d'autorisation (laissez vide pour utiliser l'en-tête par défaut)"

msgid "The address must not contain a query or a fragment."
msgstr "L'adresse ne doit pas contenir de requête ni de fragment."

msgid "The header name may contain only letters, digits and the characters !#$%&'*+-.^_`|~."
msgstr "Le nom de l'en-tête ne peut contenir que des lettres, des chiffres et les caractères !#$%&'*+-.^_`|~."

msgid "ONLYOFFICE Docs connection check succeeded (version @version)."
msgstr "La vérification de la connexion à ONLYOFFICE Docs a réussi (version @version)."

msgid "ONLYOFFICE Docs connection check failed: @error"
msgstr "La vérification de la connexion à ONLYOFFICE Docs a échoué : @error"

msgid "Error occurred in the document service"
msgstr "Une erreur s'est produite dans le service de document"

msgid "Not supported version"
msgstr "Version non supportée"

msgid "Mixed Active Content is not allowed. HTTPS address for ONLYOFFICE Docs is required."
msgstr "Le contenu mixte actif n'est pas autorisé. Une adresse HTTPS pour le ONLYOFFICE Docs est requise."

msgid "Bad healthcheck status"
msgstr "Statut de vérification d'intégrité incorrect"
