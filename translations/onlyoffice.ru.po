msgid "Allows editing office files."
msgstr "Позволяет редактировать офисные файлы."

msgid "The ONLYOFFICE connector allows users to edit office documents, spreadsheets, and presentations in the Media module from Drupal using ONLYOFFICE Docs packaged as Document Server. Users are able to collaborate on documents in real-time and preview files on public pages."
msgstr "Коннектор ONLYOFFICE позволяет пользователям редактировать текстовые документы, электронные таблицы и презентации в модуле Media в Drupal, используя редакторы документов ONLYOFFICE (объединенные в Сервер документов). Пользователи могут работать над документами совместно в режиме реального времени и просматривать файлы на публичных страницах."

msgid "Installation and configuration"
msgstr "Установка и настройка"

msgid "Explore how to install and configure the ONLYOFFICE module for Drupal on the <a href=\":onlyoffice-drupal\">official project page</a>."
msgstr "Узнайте, как установить и настроить коннектор ONLYOFFICE для Drupal, на <a href=\":onlyoffice-drupal\">официальной странице проекта</a>."

msgid "Manage ONLYOFFICE Connector settings."
msgstr "Управление настройками ONLYOFFICE Connector."

msgid "ONLYOFFICE Connector settings"
msgstr "Настройки коннектора ONLYOFFICE"

msgid "Welcome to ONLYOFFICE Docs!"
msgstr "Добро пожаловать в ONLYOFFICE Docs!"

msgid "Add office files to your Drupal website to enable document previews directly on public pages. Collaborate and edit office files with other Drupal users."
msgstr "Добавляйте офисные файлы на сайт Drupal, чтобы просматривать документы прямо на общедоступных страницах. Совместно редактируйте офисные файлы с другими пользователями Drupal."

msgid "Learn more"
msgstr "Узнать больше"

msgid "Suggest a feature"
msgstr "Предложить функцию"

msgid "Connection settings"
msgstr "Настройки подключения"

msgid "ONLYOFFICE Docs address"
msgstr "Адрес ONLYOFFICE Docs"

msgid "Here, please specify the address of your ONLYOFFICE Docs server."
msgstr "Укажите здесь адрес вашего сервера ONLYOFFICE Docs."

msgid "ONLYOFFICE Docs secret key"
msgstr "Секретный ключ ONLYOFFICE Docs"

msgid "Set a JWT secret key here and the same one in the ONLYOFFICE Docs config file. Leave blank to disable."
msgstr "Укажите здесь секретный ключ JWT и тот же ключ в файле конфигурации ONLYOFFICE Docs. Оставьте пустым, чтобы отключить."

msgid "Edit in ONLYOFFICE"
msgstr "Редактировать в ONLYOFFICE"

msgid "View in ONLYOFFICE"
msgstr "Открыть в ONLYOFFICE"

msgid "ONLYOFFICE cannot be reached. Please contact admin."
msgstr "Приложение ONLYOFFICE недоступно. Пожалуйста, свяжитесь с администратором."

msgid "Not supported version DocumentServer."
msgstr "Неподдерживаемая версия Сервера документов."

msgid "Sorry, this file format isn't supported (@extension)."
msgstr "Извините, этот формат файла не поддерживается (@extension)."

msgid "ONLYOFFICE Preview"
msgstr "ONLYOFFICE Предварительный просмотр"

msgid "Displaying files using the ONLYOFFICE editor."
msgstr "Отображение файлов с помощью редактора ONLYOFFICE."

msgid "Width units"
msgstr "Единицы ширины"

msgid "Height units"
msgstr "Единицы высоты"

msgid "Percents"
msgstr "Проценты"

msgid "Pixels"
msgstr "Пиксели"

msgid "Advanced server settings"
msgstr "Дополнительные настройки сервера"

msgid "ONLYOFFICE Docs address for internal requests from the server"
msgstr "Адрес ONLYOFFICE Docs для внутренних запросов сервера"

msgid "Server address for internal requests from ONLYOFFICE Docs"
msgstr "Адрес сервера для внутренних запросов ONLYOFFICE Docs"

msgid "Authorization header (leave blank to use default header)"
msgstr "Заголовок авторизации (оставьте пустым, чтобы использовать заголовок по умолчанию)"

msgid "The address must not contain a query or a fragment."
msgstr "Адрес не должен содержать строку запроса или фрагмент."

msgid "The header name may contain only letters, digits and the characters !#$%&'*+-.^_`|~."
msgstr "Имя заголовка может содержать только буквы, цифры и символы !#$%&'*+-.^_`|~."

msgid "ONLYOFFICE Docs connection check succeeded (version @version)."
msgstr "Проверка подключения к ONLYOFFICE Docs выполнена успешно (версия @version)."

msgid "ONLYOFFICE Docs connection check failed: @error"
msgstr "Проверка подключения к ONLYOFFICE Docs не удалась: @error"

msgid "Error occurred in the document service"
msgstr "Возникла ошибка в службе документов"

msgid "Not supported version"
msgstr "Неподдерживаемая версия"

msgid "Mixed Active Content is not allowed. HTTPS address for ONLYOFFICE Docs is required."
msgstr "Смешанное активное содержимое запрещено. Для ONLYOFFICE Docs необходимо использовать HTTPS-адрес."

msgid "Bad healthcheck status"
msgstr "Неверный статус проверки работоспособности"
