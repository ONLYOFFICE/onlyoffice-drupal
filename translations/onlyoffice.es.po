msgid "Allows editing office files."
msgstr "Permite editar archivos de oficina."

msgid "The ONLYOFFICE connector allows users to edit office documents, spreadsheets, and presentations in the Media module from Drupal using ONLYOFFICE Docs packaged as Document Server. Users are able to collaborate on documents in real-time and preview files on public pages."
msgstr "El conector de ONLYOFFICE permite a los usuarios editar documentos de oficina, hojas de cálculo y presentaciones en el módulo Media de Drupal utilizando ONLYOFFICE Docs empaquetado como Servidor de documentos. Los usuarios pueden colaborar en los documentos en tiempo real y previsualizar los archivos en las páginas públicas."

msgid "Installation and configuration"
msgstr "Instalación y configuración"

msgid "Explore how to install and configure the ONLYOFFICE module for Drupal on the <a href=\":onlyoffice-drupal\">official project page</a>."
msgstr "Descubra cómo instalar y configurar el conector de ONLYOFFICE para Drupal en la <a href=\":onlyoffice-drupal\">página oficial del proyecto</a>."

msgid "Manage ONLYOFFICE Connector settings."
msgstr "Gestione los ajustes del conector de ONLYOFFICE."

msgid "ONLYOFFICE Connector settings"
msgstr "Ajustes del conector de ONLYOFFICE"

msgid "Welcome to ONLYOFFICE Docs!"
msgstr "¡Bienvenido(a) a ONLYOFFICE Docs!"

msgid "Add office files to your Drupal website to enable document previews directly on public pages. Collaborate and edit office files with other Drupal users."
msgstr "Añada archivos de Office a su sitio web de Drupal para habilitar vistas previas de documentos directamente en páginas públicas. Colabore y edite archivos de Office con otros usuarios de Drupal."

msgid "Learn more"
msgstr "Más información"

msgid "Suggest a feature"
msgstr "Sugerir una función"

msgid "ONLYOFFICE Docs Cloud"
msgstr "ONLYOFFICE Docs Cloud"

msgid "Easily launch the editors in the cloud without downloading and installation"
msgstr "Inicie fácilmente los editores en la nube sin tener que descargarlos ni instalarlos"

msgid "Get Now"
msgstr "Obtener ahora"

msgid "Connection settings"
msgstr "Configuración de conexión"

msgid "ONLYOFFICE Docs address"
msgstr "Dirección de ONLYOFFICE Docs"

msgid "Here, please specify the address of your ONLYOFFICE Docs server."
msgstr "Aquí, especifique la dirección de su servidor de ONLYOFFICE Docs."

msgid "ONLYOFFICE Docs secret key"
msgstr "Clave secreta de ONLYOFFICE Docs"

msgid "Set a JWT secret key here and the same one in the ONLYOFFICE Docs config file. Leave blank to disable."
msgstr "Establezca aquí una clave secreta JWT y la misma en el archivo de configuración de ONLYOFFICE Docs. Déjela en blanco para desactivarla."

msgid "Edit in ONLYOFFICE"
msgstr "Editar en ONLYOFFICE"

msgid "View in ONLYOFFICE"
msgstr "Ver en ONLYOFFICE"

msgid "ONLYOFFICE cannot be reached. Please contact admin."
msgstr "No se puede establecer contacto con ONLYOFFICE. Por favor, contacte con admin."

msgid "Not supported version DocumentServer."
msgstr "Versión no soportada del Servidor de documentos."

msgid "Sorry, this file format isn't supported (@extension)."
msgstr "Lo sentimos, este formato de archivo no es compatible (@extension)."

msgid "ONLYOFFICE Preview"
msgstr "Vista previa de ONLYOFFICE"

msgid "Displaying files using the ONLYOFFICE editor."
msgstr "Visualización de archivos usando el editor ONLYOFFICE."

msgid "Width units"
msgstr "Unidades de ancho"

msgid "Height units"
msgstr "Unidades de altura"

msgid "Percents"
msgstr "Porcentajes"

msgid "Pixels"
msgstr "Píxeles"

msgid "Advanced server settings"
msgstr "Ajustes de servidor avanzados"

msgid "ONLYOFFICE Docs address for internal requests from the server"
msgstr "Dirección de ONLYOFFICE Docs para solicitudes internas del servidor"

msgid "Server address for internal requests from ONLYOFFICE Docs"
msgstr "Dirección de servidor para solicitudes internas del ONLYOFFICE Docs"

msgid "Authorization header (leave blank to use default header)"
msgstr "Encabezado de autenticación (dejar en blanco para utilizar el encabezado predeterminado)"

msgid "The address must not contain a query or a fragment."
msgstr "La dirección no debe contener una consulta ni un fragmento."

msgid "The header name may contain only letters, digits and the characters !#$%&'*+-.^_`|~."
msgstr "El nombre del encabezado solo puede contener letras, dígitos y los caracteres !#$%&'*+-.^_`|~."

msgid "ONLYOFFICE Docs connection check succeeded (version @version)."
msgstr "La comprobación de conexión con ONLYOFFICE Docs se ha realizado correctamente (versión @version)."

msgid "ONLYOFFICE Docs connection check failed: @error"
msgstr "La comprobación de conexión con ONLYOFFICE Docs ha fallado: @error"

msgid "Error occurred in the document service"
msgstr "Se ha producido un error en el servicio de documentos"

msgid "Not supported version"
msgstr "Versión no compatible"

msgid "Mixed Active Content is not allowed. HTTPS address for ONLYOFFICE Docs is required."
msgstr "Contenido Mixto Activo no está permitido. Se requiere la dirección HTTPS para ONLYOFFICE Docs."

msgid "Bad healthcheck status"
msgstr "Estado de verificación de estado incorrecto"

msgid "Invalid request."
msgstr "Solicitud no válida."

msgid "Saving a copy is not supported for this media type."
msgstr "No se admite guardar una copia para este tipo de medio."

msgid "You don't have permission to create media of this type."
msgstr "No tiene permiso para crear medios de este tipo."

msgid "The file URL does not match the ONLYOFFICE Docs address."
msgstr "La URL del archivo no coincide con la dirección de ONLYOFFICE Docs."

msgid "Failed to download the copy from ONLYOFFICE Docs."
msgstr "No se pudo descargar la copia desde ONLYOFFICE Docs."

msgid "Failed to save the copy."
msgstr "No se pudo guardar la copia."

msgid "The copy was saved as @name."
msgstr "La copia se guardó como @name."

msgid "Security"
msgstr "Seguridad"

msgid "Enable plugins"
msgstr "Habilitar plugins"

msgid "Run document macros"
msgstr "Ejecutar macros de documentos"

msgid "Enable document protection for"
msgstr "Habilitar la protección de documentos para"

msgid "All users"
msgstr "Todos los usuarios"

msgid "Owner only"
msgstr "Solo propietario"
