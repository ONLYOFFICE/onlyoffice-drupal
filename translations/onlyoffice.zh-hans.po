msgid "Allows editing office files."
msgstr "允许编辑办公文件。"

msgid "The ONLYOFFICE connector allows users to edit office documents, spreadsheets, and presentations in the Media module from Drupal using ONLYOFFICE Docs packaged as Document Server. Users are able to collaborate on documents in real-time and preview files on public pages."
msgstr "ONLYOFFICE连接器允许用户使用ONLYOFFICE文档编辑器（并入文档服务器）在Drupal的媒体模块中编辑办公文档、电子表格和演示文稿。用户可以实时协作处理文件，并在公共页面上预览文件。"

msgid "Installation and configuration"
msgstr "安装与配置"

msgid "Explore how to install and configure the ONLYOFFICE module for Drupal on the <a href=\":onlyoffice-drupal\">official project page</a>."
msgstr "访问 <a href=\":onlyoffice-drupal\">官方项目网页</a>，了解如何安装并配置ONLYOFFICE的Drupal连接器。"

msgid "Manage ONLYOFFICE Connector settings."
msgstr "管理ONLYOFFICE连接器设置。"

msgid "ONLYOFFICE Connector settings"
msgstr "ONLYOFFICE连接器的设置"

msgid "Welcome to ONLYOFFICE Docs!"
msgstr "欢迎使用 ONLYOFFICE Docs！"

msgid "Add office files to your Drupal website to enable document previews directly on public pages. Collaborate and edit office files with other Drupal users."
msgstr "将办公文件添加到您的 Drupal 网站，即可直接在公共页面上预览文档。与其他 Drupal 用户协作编辑办公文件。"

msgid "Learn more"
msgstr "了解更多"

msgid "Suggest a feature"
msgstr "建议功能"

msgid "ONLYOFFICE Docs Cloud"
msgstr "ONLYOFFICE Docs Cloud"

msgid "Easily launch the editors in the cloud without downloading and installation"
msgstr "无需下载和安装即可轻松启动云端编辑器"

msgid "Get Now"
msgstr "立即获取"

msgid "Connection settings"
msgstr "连接设置"

msgid "ONLYOFFICE Docs address"
msgstr "ONLYOFFICE Docs 地址"

msgid "Here, please specify the address of your ONLYOFFICE Docs server."
msgstr "请在此处指定您的 ONLYOFFICE Docs 服务器地址。"

msgid "ONLYOFFICE Docs secret key"
msgstr "ONLYOFFICE Docs 秘钥"

msgid "Set a JWT secret key here and the same one in the ONLYOFFICE Docs config file. Leave blank to disable."
msgstr "在此处设置 JWT 秘钥，并在 ONLYOFFICE Docs 配置文件中设置相同的秘钥。留空即可禁用。"

msgid "Edit in ONLYOFFICE"
msgstr "在ONLYOFFICE中编辑"

msgid "View in ONLYOFFICE"
msgstr "用ONLYOFFICE查看"

msgid "ONLYOFFICE cannot be reached. Please contact admin."
msgstr "无法联系到ONLYOFFICE。请联系管理员"

msgid "Not supported version DocumentServer."
msgstr "不支持的DocumentServer版本。"

msgid "Sorry, this file format isn't supported (@extension)."
msgstr "对不起，无法支持该文件格式（@extension）。"

msgid "ONLYOFFICE Preview"
msgstr "ONLYOFFICE 预览"

msgid "Displaying files using the ONLYOFFICE editor."
msgstr "使用 ONLYOFFICE 编辑器查看文件。"

msgid "Width units"
msgstr "宽度单位"

msgid "Height units"
msgstr "高度单位"

msgid "Percents"
msgstr "百分数"

msgid "Pixels"
msgstr "像素"

msgid "Advanced server settings"
msgstr "更多设置"

msgid "ONLYOFFICE Docs address for internal requests from the server"
msgstr "服务器内部请求 ONLYOFFICE Docs 的地址"

msgid "Server address for internal requests from ONLYOFFICE Docs"
msgstr "ONLYOFFICE Docs 内部请求服务器的地址"

msgid "Authorization header (leave blank to use default header)"
msgstr "授权标头 (留空以使用默认的标头)"

msgid "The address must not contain a query or a fragment."
msgstr "地址不能包含查询字符串或片段。"

msgid "The header name may contain only letters, digits and the characters !#$%&'*+-.^_`|~."
msgstr "标头名称只能包含字母、数字和字符 !#$%&'*+-.^_`|~。"

msgid "ONLYOFFICE Docs connection check succeeded (version @version)."
msgstr "ONLYOFFICE Docs 连接检查成功 (版本 @version)。"

msgid "ONLYOFFICE Docs connection check failed: @error"
msgstr "ONLYOFFICE Docs 连接检查失败: @error"

msgid "Error occurred in the document service"
msgstr "文档服务内部发生异常"

msgid "Not supported version"
msgstr "不支持的版本"

msgid "Mixed Active Content is not allowed. HTTPS address for ONLYOFFICE Docs is required."
msgstr "不允许混合活动内容，请使用HTTPS连接ONLYOFFICE Docs。"

msgid "Bad healthcheck status"
msgstr "健康检查状态异常"

msgid "Invalid request."
msgstr "无效的请求。"

msgid "Saving a copy is not supported for this media type."
msgstr "此媒体类型不支持保存副本。"

msgid "You don't have permission to create media of this type."
msgstr "您没有创建此类型媒体的权限。"

msgid "The file URL does not match the ONLYOFFICE Docs address."
msgstr "文件 URL 与 ONLYOFFICE Docs 地址不匹配。"

msgid "Failed to download the copy from ONLYOFFICE Docs."
msgstr "无法从 ONLYOFFICE Docs 下载副本。"

msgid "Failed to save the copy."
msgstr "无法保存副本。"

msgid "The copy was saved as @name."
msgstr "副本已另存为 @name。"

msgid "Security"
msgstr "安全"

msgid "Enable plugins"
msgstr "启用插件"

msgid "Run document macros"
msgstr "运行文档宏"

msgid "Enable document protection for"
msgstr "为以下用户启用文档保护"

msgid "All users"
msgstr "所有用户"

msgid "Owner only"
msgstr "仅限所有者"
