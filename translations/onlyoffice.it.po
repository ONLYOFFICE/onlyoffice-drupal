msgid "Allows editing office files."
msgstr "Consente di modificare i file di ufficio."

msgid "The ONLYOFFICE connector allows users to edit office documents, spreadsheets, and presentations in the Media module from Drupal using ONLYOFFICE Docs packaged as Document Server. Users are able to collaborate on documents in real-time and preview files on public pages."
msgstr "Il connettore ONLYOFFICE consente agli utenti di modificare file d'ufficio: documenti, fogli di calcolo e presentazioni nel modulo Media da Drupal utilizzando ONLYOFFICE Docs impacchettato come Document Server. Gli utenti possono collaborare su documenti in tempo reale e visualizzare i file in anteprima su pagine pubbliche."

msgid "Installation and configuration"
msgstr "Installazione e configurazione"

msgid "Explore how to install and configure the ONLYOFFICE module for Drupal on the <a href=\":onlyoffice-drupal\">official project page</a>."
msgstr "Scopri come installare e configurare il connettore ONLYOFFICE per Drupal sulla <a href=\":onlyoffice-drupal\">pagina ufficiale del progetto</a>."

msgid "Manage ONLYOFFICE Connector settings."
msgstr "Gestisci le impostazioni del connettore ONLYOFFICE."

msgid "ONLYOFFICE Connector settings"
msgstr "Impostazioni del connettore ONLYOFFICE"

msgid "Welcome to ONLYOFFICE Docs!"
msgstr "Benvenuto in ONLYOFFICE Docs!"

msgid "Add office files to your Drupal website to enable document previews directly on public pages. Collaborate and edit office files with other Drupal users."
msgstr "Aggiungi file di Office al tuo sito Drupal per abilitare le anteprime dei documenti direttamente nelle pagine pubbliche. Collabora e modifica i file di Office con altri utenti di Drupal."

msgid "Learn more"
msgstr "Scopri di più"

msgid "Suggest a feature"
msgstr "Suggerisci una funzione"

msgid "ONLYOFFICE Docs Cloud"
msgstr "ONLYOFFICE Docs nel Cloud"

msgid "Easily launch the editors in the cloud without downloading and installation"
msgstr "Avvia facilmente gli editor nel cloud senza scaricarli e installarli"

msgid "Get Now"
msgstr "Ottieni ora"

msgid "Connection settings"
msgstr "Impostazioni di connessione"

msgid "ONLYOFFICE Docs address"
msgstr "Indirizzo di ONLYOFFICE Docs"

msgid "Here, please specify the address of your ONLYOFFICE Docs server."
msgstr "Specifica qui l'indirizzo del tuo server ONLYOFFICE Docs."

msgid "ONLYOFFICE Docs secret key"
msgstr "Chiave segreta di ONLYOFFICE Docs"

msgid "Set a JWT secret key here and the same one in the ONLYOFFICE Docs config file. Leave blank to disable."
msgstr "Imposta qui una chiave segreta JWT e la stessa nel file di configurazione di ONLYOFFICE Docs. Lascia vuoto per disabilitare."

msgid "Edit in ONLYOFFICE"
msgstr "Modifica in ONLYOFFICE"

msgid "View in ONLYOFFICE"
msgstr "Visualizza in ONLYOFFICE"

msgid "ONLYOFFICE cannot be reached. Please contact admin."
msgstr "Impossibile raggiungere ONLYOFFICE. Si prega di contattare l'amministratore."

msgid "Not supported version DocumentServer."
msgstr "Versione DocumentServer non supportata."

msgid "Sorry, this file format isn't supported (@extension)."
msgstr "Spiacenti, questo formato di file non è supportato (@estensione)."

msgid "ONLYOFFICE Preview"
msgstr "Anteprima ONLYOFFICE"

msgid "Displaying files using the ONLYOFFICE editor."
msgstr "Visualizzazione di file utilizzando l'editor ONLYOFFICE."

msgid "Width units"
msgstr "Unità di larghezza"

msgid "Height units"
msgstr "Unità di altezza"

msgid "Percents"
msgstr "Percentuali"

msgid "Pixels"
msgstr "Pixel"

msgid "Advanced server settings"
msgstr "Impostazioni avanzate del server"

msgid "ONLYOFFICE Docs address for internal requests from the server"
msgstr "Indirizzo di ONLYOFFICE Docs per le richieste interne del server"

msgid "Server address for internal requests from ONLYOFFICE Docs"
msgstr "Indirizzo del server per le richieste interne da ONLYOFFICE Docs"

msgid "Authorization header (leave blank to use default header)"
msgstr "Intestazione di autorizzazione (lascia vuoto per utilizzare l'intestazione predefinita)"

msgid "The address must not contain a query or a fragment."
msgstr "L'indirizzo non deve contenere una query o un frammento."

msgid "The header name may contain only letters, digits and the characters !#$%&'*+-.^_`|~."
msgstr "Il nome dell'intestazione può contenere solo lettere, cifre e i caratteri !#$%&'*+-.^_`|~."

msgid "ONLYOFFICE Docs connection check succeeded (version @version)."
msgstr "Il controllo della connessione a ONLYOFFICE Docs è riuscito (versione @version)."

msgid "ONLYOFFICE Docs connection check failed: @error"
msgstr "Il controllo della connessione a ONLYOFFICE Docs non è riuscito: @error"

msgid "Error occurred in the document service"
msgstr "Si è verificato un errore nel servizio documenti"

msgid "Not supported version"
msgstr "Versione non supportata"

msgid "Mixed Active Content is not allowed. HTTPS address for ONLYOFFICE Docs is required."
msgstr "Il contenuto attivo misto non è consentito. È richiesto l'indirizzo HTTPS per ONLYOFFICE Docs."

msgid "Bad healthcheck status"
msgstr "Stato di controllo integrità non valido"

msgid "Invalid request."
msgstr "Richiesta non valida."

msgid "Saving a copy is not supported for this media type."
msgstr "Il salvataggio di una copia non è supportato per questo tipo di media."

msgid "You don't have permission to create media of this type."
msgstr "Non hai l'autorizzazione per creare media di questo tipo."

msgid "The file URL does not match the ONLYOFFICE Docs address."
msgstr "L'URL del file non corrisponde all'indirizzo di ONLYOFFICE Docs."

msgid "Failed to download the copy from ONLYOFFICE Docs."
msgstr "Impossibile scaricare la copia da ONLYOFFICE Docs."

msgid "Failed to save the copy."
msgstr "Impossibile salvare la copia."

msgid "The copy was saved as @name."
msgstr "La copia è stata salvata come @name."

msgid "Security"
msgstr "Sicurezza"

msgid "Enable plugins"
msgstr "Abilitare plugin"

msgid "Run document macros"
msgstr "Esegui le macro del documento"

msgid "Enable document protection for"
msgstr "Abilitare la protezione del documento per"

msgid "All users"
msgstr "Tutti gli utenti"

msgid "Owner only"
msgstr "Solo proprietario"

msgid "Editor customization settings"
msgstr "Impostazioni di personalizzazione dell'editor"

msgid "Display Chat menu button"
msgstr "Mostra il pulsante del menu Chat"

msgid "Display the header more compact"
msgstr "Mostra l'intestazione più compatta"

msgid "Display Feedback & Support menu button"
msgstr "Mostra il pulsante del menu Feedback e supporto"

msgid "Display Help menu button"
msgstr "Mostra il pulsante del menu Guida"

msgid "Default editor theme"
msgstr "Tema dell'editor predefinito"

msgid "Same as system"
msgstr "Uguale al sistema"

msgid "Light"
msgstr "Chiaro"

msgid "Dark"
msgstr "Scuro"

msgid "Disable certificate verification (insecure)"
msgstr "Disattiva la verifica del certificato (non sicuro)"
